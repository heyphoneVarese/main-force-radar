# ===== Backend =====

# 数据库:dev 用 SQLite,prod 切 PostgreSQL
DATABASE_URL=sqlite:///./main_force_radar.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/main_force_radar

# Anthropic Claude API(Phase 3 才用)
ANTHROPIC_API_KEY=

# Server酱 推送 SCKEY(Phase 3.8 用)
# 申请:https://sct.ftqq.com — 微信扫码登录后获取
SERVER_CHAN_SCKEY=

# APScheduler 总开关(Phase 3.11 用)
# 默认 false 安全 —— 只在 VPS 部署时设 true 才会自动推送
# 本机开发不要打开,否则每天 4 次微信推送会很烦
SCHEDULER_ENABLED=false
